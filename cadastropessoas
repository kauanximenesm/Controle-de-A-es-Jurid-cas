<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Cadastro de Pessoas | CJuris</title>
    <link rel="stylesheet" href="Css/global.css">
    <link rel="stylesheet" href="Css/login.css">
    <link rel="icon" href="Assets/favicon.ico">
</head>
<body class="login-page">
    <div class="login-container">
        <div class="login-box">
            <h2>Cadastro de Pessoas</h2>
            <form id="formPessoa">
                <div class="input-group">
                    <label>Nome Completo</label>
                    <input type="text" id="p_nome" placeholder="Nome da pessoa" required>
                </div>
                <div class="input-group">
                    <label>CPF (Apenas números)</label>
                    <input type="text" id="p_cpf" maxlength="11" placeholder="Ex: 12345678901" required>
                </div>
                <div class="input-group">
                    <label>Data de Nascimento</label>
                    <input type="date" id="p_nascimento" required>
                </div>
                <div class="input-group">
                    <label>Vínculo / Tipo:</label>
                    <select id="p_tipo" class="meu-input-estilizado">
                        <option value="4">Cliente</option>
                        <option value="1">Advogado</option>
                        <option value="3">Coordenador</option>
                    </select>
                </div>
                <button type="submit" class="btn-login">Cadastrar Pessoa</button>
            </form>
            <div class="login-footer">
                <a href="PaginaCentral.html" class="back-link">Voltar para Dashboard</a>
            </div>
        </div>
    </div>

    <script> src="Js/cadastro.js" </script> 
</body>
</html>